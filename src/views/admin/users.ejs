<%- include('../partials/header', { title: 'Admin: users', user }) %>
<h1>User accounts</h1>
<div class="table-wrap">
<table>
  <tr><th>Name</th><th>Email</th><th>Department</th><th>Role</th><th>Active</th><th></th></tr>
  <% users.forEach(u => { %>
    <tr>
      <td><%= u.name %></td>
      <td><%= u.email %></td>
      <td><%= u.department %></td>
      <td><%= u.role %></td>
      <td><span class="badge <%= u.isActive ? 'badge-approved' : 'badge-rejected' %>"><%= u.isActive ? 'active' : 'inactive' %></span></td>
      <td>
        <div class="actions">
          <a href="/admin/users/<%= u.id %>/edit" class="btn-link">Edit</a>
          <% if (u.isActive) { %>
            <form method="POST" action="/admin/users/<%= u.id %>/deactivate">
              <button type="submit" class="btn-sm btn-danger">Deactivate</button>
            </form>
          <% } else { %>
            <form method="POST" action="/admin/users/<%= u.id %>/activate">
              <button type="submit" class="btn-sm btn-secondary">Activate</button>
            </form>
          <% } %>
        </div>
      </td>
    </tr>
  <% }) %>
</table>
</div>
<%- include('../partials/footer') %>
