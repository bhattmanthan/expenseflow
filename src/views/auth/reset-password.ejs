<%- include('../partials/header', { title: 'Reset password', user }) %>
<div class="card card-narrow">
  <h1>Reset password</h1>
  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } else { %>
    <form method="POST" action="/auth/reset-password/<%= token %>">
      <div class="form-group"><label>New password</label><input type="password" name="password" required minlength="8"></div>
      <button type="submit">Reset password</button>
    </form>
  <% } %>
</div>
<%- include('../partials/footer') %>
