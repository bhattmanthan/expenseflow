<%- include('../partials/header', { title: 'Edit expense', user }) %>
<h1>Edit expense</h1>
<div class="card card-narrow">
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="POST" action="/expenses/<%= expense.id %>">
    <div class="form-group"><label>Amount</label><input type="number" step="0.01" name="amount" value="<%= expense.amount %>" required></div>
    <div class="form-group"><label>Category</label><input name="category" value="<%= expense.category %>"></div>
    <div class="form-group"><label>Date</label><input type="date" name="date" value="<%= expense.date %>" required></div>
    <div class="form-group"><label>Description</label><textarea name="description"><%= expense.description %></textarea></div>
    <button type="submit">Save</button>
  </form>
  <form method="POST" action="/expenses/<%= expense.id %>/delete">
    <button type="submit" class="btn-danger">Delete</button>
  </form>
</div>
<%- include('../partials/footer') %>
